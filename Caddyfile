# Caddy is the only thing in the production stack that listens on a public port.
# It terminates TLS, serves the built SPA, and proxies the two paths that belong
# to the backend. Nothing else is reachable from outside the Docker network.
#
# {$SITE_ADDRESS} is supplied by the deployment. In production it is the real
# hostname, which makes Caddy obtain and renew a Let's Encrypt certificate on its
# own; locally it is :80, which serves plain HTTP and asks for no certificate.
{$SITE_ADDRESS} {
	# --- Backend ----------------------------------------------------------
	# These two must come BEFORE the SPA fallback. Caddy matches the most
	# specific path first, but stating the order explicitly is what keeps
	# /api/... from being answered with index.html if that ever changes.
	#
	# `backend` resolves over the internal Docker network. The backend
	# publishes no port to the host, so this is the only route to it.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# User-uploaded images. Served by the backend from its uploads volume
	# rather than copied into this image, so a file uploaded a minute ago is
	# available without a frontend rebuild.
	handle /uploads/* {
		reverse_proxy backend:8080
	}

	# --- Static assets ----------------------------------------------------
	handle {
		root * /srv

		# Hashed filenames (index-D3tZKPlS.js) are immutable: the name changes
		# whenever the contents do, so a year-long cache is safe and means
		# repeat visitors download nothing.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# index.html must NOT be cached. It is the file that names the current
		# hashed bundles, so a cached copy pins a returning visitor to the
		# previous deployment's assets — which will already have been deleted.
		@html path / /index.html
		header @html Cache-Control "no-cache, must-revalidate"

		# SPA fallback. React Router owns the URL space, so a direct request for
		# /courses/12 or a browser refresh on any route must return index.html
		# and let the router resolve it. Without this every deep link and every
		# F5 outside "/" is a 404.
		try_files {path} /index.html
		file_server
	}

	# --- Security headers -------------------------------------------------
	header {
		# Strip the header that advertises which server and version this is.
		-Server

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Nothing here needs a camera, a microphone or a location.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	encode zstd gzip

	log {
		output stderr
		format console
	}
}

# -----------------------------------------------------------------------------
# Alternate hostnames.
# -----------------------------------------------------------------------------
# Every name that resolves to this server must be served by a site block here.
# A name that reaches Caddy without one gets no certificate at all: the TLS
# handshake is aborted before any HTTP status can be sent, so the visitor sees a
# browser security error rather than a redirect. `www.manara-edu.com` and
# `api.manara-edu.com` both have A records pointing at this host, so both need
# to be named — listing them is what makes Caddy obtain their certificates.
#
# They redirect to the canonical origin rather than serving the application a
# second time. One origin keeps the session cookie and CSRF token unambiguous:
# `MANARA_SESSION` is host-scoped, so an app served from two hostnames would
# sign a visitor out the moment they crossed between them.
#
# `{uri}` preserves the path and query, so a shared link to
# https://www.manara-edu.com/courses/12 lands on the same course.
#
# The status code is spelled out as 308 rather than using Caddy's `permanent`
# keyword, which is 301. Both are permanent, but a browser may turn a
# redirected POST into a GET on 301, silently dropping the body; 308 is the
# variant that is required to preserve the method.
#
# The default is deliberately an unreachable name: RFC 2606 reserves `.invalid`
# so it can never resolve, and the explicit `http://` scheme keeps Caddy from
# requesting a certificate for it. A local `docker run` with the default
# SITE_ADDRESS=:80 therefore starts cleanly with this block inert, while
# production sets REDIRECT_FROM to the real names.
#
# One sharp edge, because it takes the whole site down rather than degrading:
# a Caddyfile default fills in only when the variable is UNSET. Set but empty
# leaves this line with no site address, and a server block with no key is how
# a Caddyfile declares GLOBAL options — which is an error anywhere but the top
# of the file, so Caddy refuses to start and the ingress is gone. An empty
# REDIRECT_FROM= line in .env is enough to trigger it. docker-compose.prod.yml
# therefore passes ${REDIRECT_FROM:-http://alternate-hostnames.invalid}, whose
# `:-` substitutes for empty as well as unset, so the empty value never arrives.
{$REDIRECT_FROM:http://alternate-hostnames.invalid} {
	redir https://{$SITE_ADDRESS}{uri} 308
}
